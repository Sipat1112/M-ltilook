<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="70dp">
    <LinearLayout android:gravity="center_vertical" android:padding="10dp"
        android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/icon" android:layout_width="46dp" android:layout_height="46dp"/>
        <TextView android:id="@+id/name" android:textSize="16sp" android:textStyle="bold"
            android:layout_marginStart="12dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
