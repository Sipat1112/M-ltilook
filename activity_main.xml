<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="20dp"
    android:background="@color/background"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <TextView android:id="@+id/title" android:text="MultiLock"
        android:textSize="30sp" android:textStyle="bold"
        android:textColor="#171722" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Protect any app with as many PIN steps as you want."
        android:textSize="15sp" android:textColor="#6B6B78"
        android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/serviceCard" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <LinearLayout android:padding="16dp" android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/serviceStatus" android:text="Protection is OFF"
                android:textStyle="bold" android:textSize="17sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/serviceHint" android:text="Turn on Accessibility access to monitor protected apps."
                android:textSize="14sp" android:textColor="#6B6B78"
                android:layout_marginTop="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/serviceButton" android:text="Enable protection"
                android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addAppButton" android:text="+  Add an app"
        android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="56dp"/>

    <TextView android:text="Protected apps" android:textStyle="bold" android:textSize="19sp"
        android:layout_marginTop="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

    <ListView android:id="@+id/appList" android:divider="@android:color/transparent"
        android:dividerHeight="10dp" android:layout_marginTop="10dp"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
